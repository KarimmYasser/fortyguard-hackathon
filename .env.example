# ==============================================================================
# FortyGuard Hackathon '26 — Environment Configuration
# ==============================================================================

# Optional external validation credentials (IEM/Open-Meteo require no key)
NREL_API_KEY=
NREL_EMAIL=
# Synoptic station API requires the generated access token, not the account API key.
SYNOPTIC_TOKEN=
# Legacy compatibility alias. If used by this repository, it must contain a usable access token.
SYNOPTIC_API_KEY=
EIA_API_KEY=

# FortyGuard Temperature API (from https://dashboard.fortyguard.com)
FORTYGUARD_API_KEY=your_fortyguard_api_key_here
FORTYGUARD_BASE_URL=https://api.fortyguard.com
# Set to 'true' to force offline simulation fixture (Phoenix July 2023 benchmark), or 'false' for live API calls
MOCK_FORTYGUARD_API=false

# Supabase Cloud Database Configuration (Optional - falls back to local SQLite if missing)
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_KEY="eyJhbGciOiJIUzI1NiIsIn..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsIn..."

# alphaXiv Academic Research API / MCP (from https://alphaxiv.org)
ALPHAXIV_API_KEY=your_alphaxiv_bearer_token_here
ALPHAXIV_API_BASE_URL=https://api.alphaxiv.org/v1

# Siemens SDC LLM Gateway Configuration
# Base URL: https://llm.sdc.siemens.cloud/v1
SDC_LLM_API_KEY=your_sdc_llm_gateway_api_key_here
SDC_LLM_BASE_URL=https://llm.sdc.siemens.cloud/v1

# Default Model Selection (OpenAI-compatible or Anthropic-compatible)
# OpenAI Models: gpt-5, gpt-5-mini, gpt-5.4, gpt-5.4-pro, gpt-5.5
# Anthropic Models: claude-sonnet-4-6@default, claude-sonnet-5@default, claude-opus-4-5@20251101, claude-haiku-4-5@20251001
DEFAULT_LLM_PROVIDER=openai
DEFAULT_LLM_MODEL=gpt-5-mini
DEFAULT_LLM_TEMPERATURE=0.1

# Fallback direct provider keys (if not using SDC gateway)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# --- FortyGuard live analytics tuning ---
FORTYGUARD_ANALYSIS_DATE=2023-07-19
FORTYGUARD_MAX_CONCURRENCY=6
FORTYGUARD_ENV_TIMEOUT_S=180
