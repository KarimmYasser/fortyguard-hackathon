# ==============================================================================
# FortyGuard Hackathon '26 — Environment Configuration
# ==============================================================================

# FortyGuard Temperature API (obtain from https://dashboard.fortyguard.com)
FORTYGUARD_API_KEY=your_fortyguard_api_key_here
FORTYGUARD_API_BASE_URL=https://api.fortyguard.com/v1

# alphaXiv Academic Research API / MCP (obtain from https://alphaxiv.org)
ALPHAXIV_API_KEY=your_alphaxiv_bearer_token_here
ALPHAXIV_API_BASE_URL=https://api.alphaxiv.org/v1

# LLM Providers (for LangGraph multi-agent orchestration)
# OpenAI / Anthropic / Google Gemini
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GOOGLE_API_KEY=your_gemini_api_key_here

# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
